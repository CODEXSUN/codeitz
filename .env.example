# Copy to .env. Process environment variables override this file.
NODE_ENV=development
CODEITZ_HOST=127.0.0.1
CODEITZ_PORT=4305
CODEITZ_LOG_LEVEL=info
CODEITZ_SHUTDOWN_TIMEOUT_MS=10000
# Relative to this Codeitz repository, or use an absolute workspace path.
CODEITZ_WORKSPACE_ROOT=../..

# PostgreSQL owns all Codeitz application data, task history and chat records.
# Local codeitz database is provisioned; use a restricted role in production.
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=codeitz
PGUSER=postgres
PGPASSWORD=
PGSSLMODE=disable
# Local setting only. Cloud/production requires verified TLS (verify-full).

CODEITZ_WEB_PORT=4300

# Owner-only module final approval. Keep private; never expose to agents or browser bundles.
CODEITZ_OWNER_APPROVAL_KEY=

# Remote connected app secret; set the matching environment variable name in Sync → Connected apps.
CODEITZ_SYNC_REMOTE_SECRET=
