{
  "type": "module",
  "version": "1.0.8",
  "private": true,
  "name": "@workspace/codeitz",
  "dependencies": {
    "@workspace/framework": "file:../../foundation/framework",
    "@workspace/ui": "file:../../packages/ui",
    "kysely": "0.29.9",
    "lucide-react": "1.73.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7",
    "@excalidraw/excalidraw": "0.18.1"
  },
  "scripts": {
    "dev": "node --watch scripts/start.ts",
    "build": "vite build",
    "start": "node scripts/start.ts",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs tools/*.test.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "audit:governance": "node scripts/run-audit.ts",
    "verify": "npm run typecheck && npm run build && npm test && npm run check:versions && npm run audit:governance",
    "preflight": "node scripts/preflight.ts",
    "github:audit": "node tools/github-helper.mjs --dry-run",
    "version:show": "node tools/check-versions.mjs",
    "version:bump": "node tools/version-bump.mjs",
    "version:preview": "node tools/version-bump.mjs --dry-run",
    "check:versions": "node tools/check-versions.mjs",
    "test:tools": "node --test tools/*.test.mjs",
    "db:migrate": "node scripts/database.ts",
    "db:status": "node scripts/database.ts --status",
    "db:seed": "node scripts/seed.ts",
    "db:import:todos": "node scripts/import-todos.ts",
    "github:now": "node tools/github-helper.mjs",
    "github:ssh-key": "node tools/github-ssh-key.mjs",
    "version:update": "node tools/version-bump.mjs",
    "db:import:projects": "node scripts/import-projects.ts",
    "db:import:runtime": "node scripts/import-runtime.ts",
    "dev:api": "node --watch scripts/start.ts",
    "dev:web": "vite",
    "projects:sync": "node scripts/sync-projects.ts"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "latest",
    "@types/pg": "8.23.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.8"
  },
  "overrides": {
    "lodash-es": "4.18.1",
    "nanoid@<4": "3.3.20",
    "nanoid@>=4 <6": "5.1.16",
    "katex": "0.19.1"
  }
}
